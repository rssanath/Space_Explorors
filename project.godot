; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but can be also edited using a text editor.

config_version=5

[application]

config/name="MARS DEEP"
config/description="Design. Launch. Explore. Educational Mars mission design and simulation game for the NASA Space Apps Challenge."
config/version="1.0.0"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameManager="*res://scripts/GameManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true

[gui]

theme/custom="res://assets/themes/MarsDeepTheme.tres"

