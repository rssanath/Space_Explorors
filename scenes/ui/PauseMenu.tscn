layout_mode = 2

[node name="VBoxHelp" type="VBoxContainer" parent="CenterContainer/ModalControls/Margin/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Sec1" type="Label" parent="CenterContainer/ModalControls/Margin/VBox/Scroll/VBoxHelp"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.48, 0, 1)
theme_override_font_sizes/font_size = 13
text = "• STAGE B: 3D SPACECRAFT DESIGNER"

[node name="Desc1" type="Label" parent="CenterContainer/ModalControls/Margin/VBox/Scroll/VBoxHelp"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 11
text = "Click subsystem cards on left to select hardware. Drag right-click to orbit 3D view. Middle mouse to zoom. Verify Power balance and Mass budget on right."

[node name="Sec2" type="Label" parent="CenterContainer/ModalControls/Margin/VBox/Scroll/VBoxHelp"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.48, 0, 1)
theme_override_font_sizes/font_size = 13
text = "• STAGE D: ROCKET LAUNCH & COUNTDOWN"

[node name="Desc2" type="Label" parent="CenterContainer/ModalControls/Margin/VBox/Scroll/VBoxHelp"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 11
text = "Slide throttle lever or press [W] to increase thrust. Hold-down clamps automatically release at 90%+ throttle for liftoff. Press [1], [2], [3] for camera views."

[node name="Sec3" type="Label" parent="CenterContainer/ModalControls/Margin/VBox/Scroll/VBoxHelp"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.48, 0, 1)
theme_override_font_sizes/font_size = 13
text = "• STAGE E: INTERPLANETARY SPACEFLIGHT"

[node name="Desc3" type="Label" parent="CenterContainer/ModalControls/Margin/VBox/Scroll/VBoxHelp"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 11
text = "[A]/[D] to Yaw attitude. [Q]/[E] to Roll spacecraft. [W]/[S] to adjust propulsion throttle. [C] to cycle cameras (Cockpit, Exterior, Nav Map, Mars Arrival)."

[node name="Sec4" type="Label" parent="CenterContainer/ModalControls/Margin/VBox/Scroll/VBoxHelp"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.48, 0, 1)
theme_override_font_sizes/font_size = 13
text = "• STAGE F: MARS POWERED DESCENT & ROVER DRIVING"

[node name="Desc4" type="Label" parent="CenterContainer/ModalControls/Margin/VBox/Scroll/VBoxHelp"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 11
text = "Descent: [W]/[S] throttle retro-engines, [A]/[D] adjust drift. Target touchdown vertical speed < 1.5 m/s.\nRover Driving: [W]/[S] forward/reverse, [A]/[D] steering, [Space] handbrake. Press [E] near targets to deploy robotic arm and cache science sample."

